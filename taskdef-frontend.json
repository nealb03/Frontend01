{
  "family": "brentaneal-frontend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::288761763536:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::288761763536:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "frontend-container",
      "image": "288761763536.dkr.ecr.us-east-1.amazonaws.com/brentaneal-frontend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "VITE_API_BASE_URL",
          "value": "https://allcloudsvcs.com"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/brentaneal-frontend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }
  ]
}